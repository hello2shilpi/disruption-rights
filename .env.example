# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is in .gitignore and must never be committed. This file — the example,
# with no real values — is committed, so anyone cloning the repo knows what
# keys they need.

# The course practice key (study.modernaipro.com/practice)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
# auto tries Responses first, then Chat Completions on a 404.
OPENAI_API_MODE=auto

# Retriever 1 — live flight status. Pick one, free tier is enough because the
# graded runs use recorded fixtures rather than the live API.
AVIATIONSTACK_API_KEY=
# AERODATABOX_API_KEY=

# Optional: cap spend per verdict, in US dollars.
MAX_COST_PER_VERDICT=0.05
MAX_TOOL_CALLS=6
